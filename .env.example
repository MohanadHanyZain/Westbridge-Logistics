# ==============================================================================
# Application Brand & Defaults (Client-safe public config)
# ==============================================================================
VITE_APP_BRAND_NAME="ShipFlow"
VITE_DEFAULT_TIMEZONE="Africa/Cairo"
VITE_DEFAULT_CURRENCY="EGP"
VITE_DEFAULT_LOCALE="ar-EG"

# ==============================================================================
# Platform Base Domain (used for tenant subdomains and host-based routing)
# Tenant hosts are {slug}.{VITE_PLATFORM_BASE_DOMAIN}; changing the domain in
# the database (public.platform_settings.base_domain) must match this value.
# ==============================================================================
VITE_PLATFORM_BASE_DOMAIN="westbridge-logistics.com"

# ==============================================================================
# Supabase (External BaaS) - Client-safe keys ONLY
